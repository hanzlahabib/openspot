<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>OpenSpot</string>
  <key>CFBundleDisplayName</key><string>OpenSpot</string>
  <key>CFBundleIdentifier</key><string>org.openspot.OpenSpot</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleExecutable</key><string>openspot-gui</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- CoreWLAN returns no SSID/BSSID without Location Services authorisation. -->
  <key>NSLocationUsageDescription</key>
  <string>macOS requires location access before it lets an app read the names of nearby Wi-Fi networks. OpenSpot does not use or store your location.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>macOS requires location access before it lets an app read the names of nearby Wi-Fi networks. OpenSpot does not use or store your location.</string>
</dict>
</plist>
