; Inno Setup 6 script for the OpenSpot per-user installer.
;
; Needs Inno Setup 6.3 or newer (for ArchitecturesAllowed=x64compatible).
; UNVERIFIED: written against the Inno Setup 6 documentation and never compiled or run on Windows.
; Build with build-installer.ps1, which injects the version from Cargo.toml:
;   ISCC.exe /DAppVersion=0.1.0 /DBinDir=<release dir> /DRepoRoot=<repo> /DOutDir=<dist> openspot.iss

#ifndef AppVersion
  #error AppVersion is not defined. Pass /DAppVersion=<x.y.z> (build-installer.ps1 reads it from Cargo.toml).
#endif
#ifndef BinDir
  #error BinDir is not defined. Pass /DBinDir=<folder holding openspot.exe and openspot-gui.exe>.
#endif
#ifndef RepoRoot
  #error RepoRoot is not defined. Pass /DRepoRoot=<repository root>.
#endif
#ifndef OutDir
  #define OutDir "dist"
#endif

#define AppName "OpenSpot"
#define AppExe "openspot-gui.exe"
; Placeholder: the repository URL is not final (see SECURITY.md and the update check).
#define AppUrl "https://github.com/hanzlahabib/openspot"

[Setup]
; Never change AppId: Windows uses it to recognise an existing install for upgrades and uninstall.
AppId={{8A6E9D14-46AD-4FAD-86E9-7E60C8893A35}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher=The OpenSpot contributors
AppPublisherURL={#AppUrl}
AppSupportURL={#AppUrl}/issues
AppUpdatesURL={#AppUrl}/releases
; Per-user install: no administrator prompt. {autopf} resolves to %LOCALAPPDATA%\Programs.
PrivilegesRequired=lowest
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
OutputDir={#OutDir}
OutputBaseFilename=openspot-v{#AppVersion}-windows-x86_64-setup
UninstallDisplayName={#AppName}
UninstallDisplayIcon={app}\{#AppExe}
; Needed so Explorer refreshes after the optional file association below.
ChangesAssociations=yes
; Signing is optional; build-installer.ps1 defines SignToolEnabled and the "openspotsign" command.
#ifdef SignToolEnabled
SignTool=openspotsign
SignedUninstaller=yes
#endif

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; Flags: unchecked
; The application opens a project (or imports an archive) passed as its first argument, so the
; "open" verbs below pass "%1". UNVERIFIED on Windows: this script was never compiled or run.
Name: "associate"; Description: "Open &.ospot and .ospotz files with OpenSpot"

[Files]
Source: "{#BinDir}\openspot-gui.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#BinDir}\openspot.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#RepoRoot}\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#RepoRoot}\CHANGELOG.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#RepoRoot}\LICENSE-APACHE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#RepoRoot}\LICENSE-MIT"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
; HKA is HKCU for a per-user install and HKLM if the user elevates, so the keys follow the install scope.
Root: HKA; Subkey: "Software\Classes\.ospot"; ValueType: string; ValueData: "OpenSpot.Project"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.ospotz"; ValueType: string; ValueData: "OpenSpot.Archive"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\OpenSpot.Project"; ValueType: string; ValueData: "OpenSpot project"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\OpenSpot.Project\DefaultIcon"; ValueType: string; ValueData: "{app}\{#AppExe},0"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\OpenSpot.Project\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: associate
Root: HKA; Subkey: "Software\Classes\OpenSpot.Archive"; ValueType: string; ValueData: "OpenSpot project archive"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\OpenSpot.Archive\DefaultIcon"; ValueType: string; ValueData: "{app}\{#AppExe},0"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\OpenSpot.Archive\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: associate

[Run]
Filename: "{app}\{#AppExe}"; Description: "Start {#AppName}"; Flags: nowait postinstall skipifsilent

; The uninstaller is generated by Inno Setup and removes everything listed above. Preferences and
; projects are user data and are deliberately left alone: %APPDATA%\OpenSpot\prefs.json stays.
